# npm's settings for this repository.
#
# `npm audit` runs by default on every install: it POSTs the whole dependency
# tree to the registry's advisory service and WAITS for the answer before the
# install finishes. That is the part worth objecting to, and it is why this is
# off — not because the audit is expensive, and not because what it reports
# does not matter.
#
# What made the point was an outage. On 2026-09-04 the bulk advisory endpoint
# stopped answering promptly, and every install everywhere paid for it:
#
#   npm http fetch POST 200 .../security/advisories/bulk   276875ms
#   npm http fetch GET  200 .../dompurify                      24ms
#
# Four and a half minutes in that one request, twenty milliseconds in every
# other request beside it. The cost did not depend on what the install then
# did, so `npm install` took the same seven minutes when it had four hundred
# packages to add, when it had two, and when it had nothing to do at all — on a
# laptop and on a CI runner, which is what ruled out both machines.
# npm and bun were affected alike: github.com/orgs/community/discussions/187552
#
# An outage will pass. The shape of the problem does not: an install that
# cannot finish until a third-party service answers is an install that stops
# working for reasons that have nothing to do with this project, and it fails
# slowly rather than loudly. Nothing is given up by refusing that, because an
# install-time audit does not fail the install — it printed a count that
# everybody scrolled past, and it has never gated anything here.
#
# Ask it deliberately instead, when somebody is going to act on the answer:
#
#   npm audit           # what is currently known
#   npm audit fix       # and what can be fixed without a breaking change
#
# fund=false is only noise removal: seventy-odd packages asking for funding on
# every install, in a list nobody reads.
audit=false
fund=false
