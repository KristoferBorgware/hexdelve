# npm's settings for this repository.
#
# audit=false is here for one measured reason. `npm audit` runs by default on
# every install, POSTs the whole dependency tree to the registry and waits for
# the answer, and that request was taking FOUR AND A HALF MINUTES:
#
#   npm http fetch POST 200 .../security/advisories/bulk   276875ms
#   npm http fetch GET  200 .../dompurify                      24ms
#
# Every other request in the same install was about twenty milliseconds. The
# cost is also fixed: the whole tree is sent whether npm went on to install
# four hundred packages or two, which is why `npm install` took the same seven
# minutes when it had nothing to do as when it had everything to do, on a
# laptop and on a CI runner alike.
#
# Turning it off loses nothing that was being acted on. An install-time audit
# does not fail the install, so it has never gated anything here — it printed a
# count that everybody scrolled past. Run it deliberately instead:
#
#   npm audit           # what is currently known
#   npm audit fix       # and what can be fixed without a breaking change
#
# fund=false is only noise removal: seventy-odd packages asking for funding on
# every install, in a list nobody reads.
audit=false
fund=false
