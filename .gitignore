node_modules/
dist/
dist-app/
dist-lib/
dist-scripts/
dist-types/
release/
*.tsbuildinfo
.vite/

# IDE
.idea/
.vscode/

# OS
.DS_Store

# Claude Code local settings (launch.json is tracked on purpose)
.claude/settings.local.json
