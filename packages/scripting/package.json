{
	"name": "@hexdelve/scripting",
	"version": "0.1.0",
	"description": "Hexdelve scripting — the component base game behaviour is written as, and the host that runs it",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -b",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"@hexdelve/engine": "*",
		"@hexdelve/shared": "*"
	}
}
