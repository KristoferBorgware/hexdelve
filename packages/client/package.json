{
	"name": "@hexdelve/client",
	"version": "0.1.0",
	"description": "Hexdelve client — the game itself, mounted on a canvas",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"dist-lib",
		"src"
	],
	"sideEffects": false,
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && vite build --config vite.lib.config.ts",
		"build:app": "vite build",
		"build:lib": "vite build --config vite.lib.config.ts",
		"preview": "vite preview",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"@hexdelve/engine": "*",
		"@hexdelve/shared": "*"
	},
	"devDependencies": {
		"vite": "^8.2.2"
	}
}
