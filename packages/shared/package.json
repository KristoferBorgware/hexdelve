{
	"name": "@hexdelve/shared",
	"version": "0.1.0",
	"description": "Dependency-free math, hex coordinates and types shared by every Hexdelve package",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -b",
		"typecheck": "tsc -b"
	}
}
