{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"tsBuildInfoFile": "./dist/.tsbuildinfo",
		"module": "CommonJS",
		"moduleResolution": "Node10",
		"lib": ["ES2022"],
		"types": ["node"],

		// Electron's main process runs CommonJS, and a CommonJS preload is the
		// only kind a sandboxed renderer will load. That rules out
		// verbatimModuleSyntax, which would keep ESM `import` statements.
		"verbatimModuleSyntax": false
	},
	"include": ["src/**/*.ts"]
}
