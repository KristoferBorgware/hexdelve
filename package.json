{
	"name": "hexdelve",
	"version": "0.1.0",
	"private": true,
	"description": "Hexagon game-world engine, client and editor",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/KristoferBorgware/hexdelve.git"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"workspaces": [
		"packages/shared",
		"packages/engine",
		"packages/client",
		"packages/editor",
		"packages/desktop"
	],
	"scripts": {
		"build": "npm run build:libs && npm run build:client && npm run build:editor",
		"build:libs": "tsc -b packages/shared packages/engine packages/client packages/desktop",
		"build:client": "npm run build -w @hexdelve/client",
		"build:editor": "npm run build -w @hexdelve/editor",
		"build:desktop": "npm run build -w @hexdelve/desktop",
		"build:pages": "npm run build && node tools/build-pages.js",
		"dev:client": "npm run dev -w @hexdelve/client",
		"dev:editor": "npm run dev -w @hexdelve/editor",
		"dev:desktop": "npm run dev -w @hexdelve/desktop",
		"index": "node tools/build-index.js",
		"typecheck": "tsc -b packages/shared packages/engine packages/client packages/editor packages/desktop && tsc -p tsconfig.tools.json",
		"check:shaders": "node tools/check-shaders.mjs",
		"check:picking": "node tools/check-picking.mjs",
		"check:tiles": "node tools/check-tiles.mjs",
		"check:blend": "node tools/check-blend.mjs",
		"check:render": "node tools/check-render.mjs",
		"check:backends": "node tools/check-backends.mjs",
		"clean": "node tools/clean.js"
	},
	"devDependencies": {
		"playwright": "1.56.1",
		"typescript": "5.9.3"
	}
}
